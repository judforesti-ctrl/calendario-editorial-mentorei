{
  "name": "Calendário Editorial Mentorei",
  "short_name": "Calendário",
  "description": "Calendário de posts, stories, destaques e arquivos da Mentorei.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#091216",
  "theme_color": "#091216",
  "lang": "pt-BR",
  "icons": [
    { "src": "/assets/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/assets/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{ "name": "arquivos", "accept": ["image/*", "video/*"] }]
    }
  }
}
